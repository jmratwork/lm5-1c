---
# =============================================================================
# EXAMPLE Ansible Vault file for the PUC2 2c overlay.
#
#   cp vault.yml.example vault.yml && $EDITOR vault.yml
#   ansible-vault encrypt provisioning/group_vars/vault.yml
#
# `vault.yml` is git-ignored - NEVER commit the decrypted file.
#
# NOTE: on a normal run you do NOT need to fill anything in here. The
# docker_server role of the integrations substrate discovers the live MISP and
# DFIR-IRIS API keys at provision time and publishes them as cacheable facts;
# puc2_2c.yml prefers those facts and only falls back to these values. Set them
# when running the overlay standalone against a pre-provisioned sandbox.
# =============================================================================

# --- CTI-SS (MISP) — overrides hostvars['docker-server'].misp_api_key --------
vault_misp_api_key: "CHANGE_ME"

# --- CICMS (DFIR-IRIS) — overrides hostvars['docker-server'].iris_api_key ----
vault_iris_api_key: "CHANGE_ME"

# --- Optional bootstrap key probed by docker_server before it reads the real --
# --- one out of iris_db. Leave empty unless a pre-seeded key genuinely      ---
# --- exists: the key that used to be hardcoded in the role is stale and has ---
# --- been removed. A value here belongs in an ansible-vault encrypted file. ---
vault_iris_bootstrap_key: ""

# --- Optional: password applied to the victim user by the reset-credentials --
# --- containment action (UML step 10). Empty = only expire the password.  ----
#   mkpasswd --method=sha-512
vault_victim_new_password_hash: ""

# --- Docker Hub (REQUIRED in practice) ---------------------------------------
# Leave empty and the login task is skipped and images pull anonymously — which
# on this range HITS Docker Hub's anonymous rate limit and fails the deployment
# with a 429 while pulling DFIR-IRIS's images. Set a working PAT. The one that
# used to be hardcoded in roles/docker_server is public on GitHub: revoke it and
# issue a new one, do not reuse it.
vault_dockerhub_user: ""
vault_dockerhub_pat: ""

# --- Console password for the `ubuntu` account -------------------------------
# Applied by roles/docker_server and roles/victim. Leave empty and the password
# is LEFT UNTOUCHED (the task omits it) — set one if trainees need to log in at
# the graphical console prompt rather than over SSH keys.
#   mkpasswd --method=yescrypt
# The hash that used to be hardcoded is public on GitHub and must be replaced.
vault_ubuntu_password_hash: ""
