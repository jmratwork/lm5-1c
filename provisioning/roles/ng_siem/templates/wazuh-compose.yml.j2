# NG-SIEM = Wazuh single-node (indexer + manager + dashboard).
# Rendered by role ng_siem. Secrets are injected from the .env file (vault).
services:
  wazuh-manager:
    image: wazuh/wazuh-manager:{{ wazuh_version }}
    container_name: wazuh-manager
    restart: always
    ports:
      - "{{ wazuh_manager_events_port }}:1514"
      - "{{ wazuh_manager_registration_port }}:1515"
      - "55000:55000"
    environment:
      - INDEXER_URL=https://wazuh-indexer:9200
      - INDEXER_USERNAME=admin
      - INDEXER_PASSWORD=${WAZUH_INDEXER_PASSWORD}
      - API_PASSWORD=${WAZUH_API_PASSWORD}
    volumes:
      - wazuh_etc:/var/ossec/etc
      - wazuh_logs:/var/ossec/logs
      # Custom correlation rules (UML steps 5 & 6).
      - {{ siem_deploy_dir }}/local_rules.xml:/var/ossec/etc/rules/local_rules.xml

  wazuh-indexer:
    image: wazuh/wazuh-indexer:{{ wazuh_version }}
    container_name: wazuh-indexer
    restart: always
    ports:
      - "{{ wazuh_indexer_port }}:9200"
    environment:
      - "OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g"
      - bootstrap.memory_lock=true
    ulimits:
      memlock:
        soft: -1
        hard: -1
    volumes:
      - wazuh_indexer_data:/var/lib/wazuh-indexer

  wazuh-dashboard:
    image: wazuh/wazuh-dashboard:{{ wazuh_version }}
    container_name: wazuh-dashboard
    restart: always
    ports:
      - "{{ wazuh_dashboard_port }}:5601"
    environment:
      - INDEXER_USERNAME=admin
      - INDEXER_PASSWORD=${WAZUH_INDEXER_PASSWORD}
      - DASHBOARD_USERNAME=kibanaserver
      - DASHBOARD_PASSWORD=${WAZUH_DASHBOARD_PASSWORD}
    depends_on:
      - wazuh-indexer

volumes:
  wazuh_etc:
  wazuh_logs:
  wazuh_indexer_data:
