#!/usr/bin/env bash
# =============================================================================
# Post-incident evidence collection + feedback generation — UML step 13.
#
# Runs on ng-siem ({{ puc2_ng_siem_ip }}), where the siemng image runs
# wazuh-manager NATIVELY under systemd (NOT in a container — do not reach for
# `docker exec wazuh-manager` here). Aggregates the NG-SIEM alerts, the active
# response log and the containment markers pulled back off the endpoint into
# one report for the cyber-range debrief.
# =============================================================================
set -uo pipefail

EVAL_ROOT="{{ puc2_eval_root }}"
VICTIM_IP="{{ puc2_victim_ip }}"
VICTIM_MGMT_USER="{{ puc2_victim_mgmt_user }}"
OUT="${EVAL_ROOT}/report_$(date +%Y%m%d-%H%M%S).txt"
# The endpoint half of the report comes over a dedicated key that this role
# authorises on the victim ONLY from {{ puc2_ng_siem_ip }} and ONLY for a forced,
# read-only command (/usr/local/sbin/puc2-evidence): whatever is asked, that
# script runs, prints the two markers and the active-response log, and exits.
# Before it existed nothing authorised this host at all, so the section always
# read "unreachable ... host may be isolated" - the isolation keeps the sandbox
# subnet open; it was the missing key.
EVIDENCE_KEY="{{ puc2_eval_key }}"
SSH_OPTS="-i ${EVIDENCE_KEY} -o StrictHostKeyChecking=no -o ConnectTimeout=10 -o BatchMode=yes"

mkdir -p "${EVAL_ROOT}"

{
  echo "==== PUC2 (CYNET) Sub Case 2c — Training Evaluation Report ===="
  echo "Generated: $(date -Iseconds) on $(hostname)"
  echo

  echo "---- Detection: NG-SIEM alerts for the 2c ruleset (UML steps 3-6) ----"
  for rid in 100100 100101 100102 100103; do
    # grep -c already prints 0 when nothing matches - and exits 1, so the old
    # "|| echo 0" printed a second 0 on its own line. Default only an empty answer
    # (missing file).
    n=$(grep -c "\"id\":\"${rid}\"" /var/ossec/logs/alerts/alerts.json 2>/dev/null)
    echo "  rule ${rid}: ${n:-0} alert(s)"
  done
  echo
  echo "  last 50 matching alert lines:"
  grep -E '"id":"1001(00|01|02|03)"' /var/ossec/logs/alerts/alerts.json 2>/dev/null \
    | tail -n 50 || echo "  (no alerts yet — the scenario may not have been injected)"
  echo

  # The active response runs ON the endpoint and logs there; the manager's
  # active-responses.log never records it, so that section only ever said "no
  # invocation recorded". Containment status and the AR log both come from the
  # endpoint, in one read-only call.
  echo "---- Response, containment & eradication on the endpoint (UML steps 9-11) ----"
  # shellcheck disable=SC2086
  ssh ${SSH_OPTS} "${VICTIM_MGMT_USER}@${VICTIM_IP}" 2>/dev/null \
    | sed 's/^/    /' \
    || echo "    (no answer from ${VICTIM_IP} over the evidence key ${EVIDENCE_KEY}; read the markers on the victim itself)"
  echo

  echo "---- Collaboration surfaces (UML steps 7-8, 12) ----"
  echo "  CICMS  (DFIR-IRIS): {{ puc2_iris_url }}   — cases opened by the custom-iris integration"
  echo "  CTI-SS (MISP):      {{ puc2_misp_url }}   — sharing group '{{ puc2_misp_sharing_group_name }}'"
  echo "  NG-SOAR webhook:    {{ puc2_soar_webhook_url }}"
} > "${OUT}" 2>&1

echo "Evaluation report written to ${OUT}"
echo "Now complete ${EVAL_ROOT}/lessons_learned_template.md with the trainees."
