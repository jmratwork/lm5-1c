#!/usr/bin/env bash
# NG-SOAR containment runner (UML steps 9-11).
# Executes the containment playbooks against the affected endpoint(s) and
# emits a status line that NG-SOAR returns to the SOC Analyst (step 11).
# Usage: run_containment.sh <endpoint_ip>
set -euo pipefail

TARGET="${1:?Usage: run_containment.sh <endpoint_ip>}"
PB_DIR="{{ ngsoar_playbook_dir }}"
INV="${PB_DIR}/targets.ini"

echo "[NG-SOAR] Containment started for ${TARGET}"

ansible-playbook -i "${INV}" "${PB_DIR}/isolate_host.yml"        -e "target=${TARGET}"
ansible-playbook -i "${INV}" "${PB_DIR}/block_malicious_ip.yml"  -e "target=${TARGET}" \
  -e '{"block_ips": {{ ngsoar_block_ips | to_json }} }'
ansible-playbook -i "${INV}" "${PB_DIR}/reset_credentials.yml"   -e "target=${TARGET}"
ansible-playbook -i "${INV}" "${PB_DIR}/quarantine_and_patch.yml" -e "target=${TARGET}"

echo "[NG-SOAR] Containment & eradication COMPLETE for ${TARGET}"
