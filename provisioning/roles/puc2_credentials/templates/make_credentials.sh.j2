#!/usr/bin/env bash
# =============================================================================
# Assemble the SOC dashboard credentials file on this node.
#
# It reads the passwords out of the deployed .env files at RUN TIME and writes
# them straight to a 0600 file. No password is ever echoed to stdout (so nothing
# lands in the Ansible log) and none is passed on a command line. Where a value
# is not in the .env, the file says so explicitly and where to get it — it is
# never invented.
# =============================================================================
set -euo pipefail
umask 077

OUT="{{ puc2_cred_file }}"
MISP_ENV="{{ puc2_misp_env_file }}"
IRIS_ENV="{{ puc2_iris_env_file }}"
tmp="$(mktemp)"

# getenv KEY FILE -> value, or empty when the key is absent.
#
# The trailing `|| true` is load-bearing. Under `set -euo pipefail` a grep that
# matches nothing exits 1, pipefail propagates it, and the assignment
# `mp="$(getenv ...)"` then aborts the whole script — killing it before it can
# reach the "NOT FOUND" branch written for exactly that case. A missing key is a
# normal outcome here, not an error: MISP's .env does not carry ADMIN_PASSWORD
# unless someone set it.
getenv() {
    [ -f "$2" ] || return 0
    { grep -E "^$1=" "$2" 2>/dev/null | tail -1 | cut -d= -f2-; } || true
}

{
    echo "PUC2 2c — SOC dashboard credentials"
    echo "Published inside the sandbox at provision time. Do not copy off-node."
    echo "This file is 0600/root on purpose."
    echo

    echo "== CTI-SS (MISP)   https://{{ docker_server_internal_ip }}:8443 =="
    echo "  user: {{ puc2_misp_admin_user }}"
    mp="$(getenv ADMIN_PASSWORD "$MISP_ENV")"
    if [ -n "$mp" ]; then
        echo "  pass: $mp"
        echo "        (from $MISP_ENV : ADMIN_PASSWORD)"
    else
        echo "  pass: NOT FOUND in $MISP_ENV (ADMIN_PASSWORD)."
        echo "        MISP-docker's default admin password is 'admin' unless the"
        echo "        image set one; confirm in that .env before handing over."
    fi
    echo

    echo "== CICMS (DFIR-IRIS)   https://{{ docker_server_internal_ip }}:8083 =="
    echo "  user: {{ puc2_iris_admin_user }}"
    ip="$(getenv IRIS_ADM_PASSWORD "$IRIS_ENV")"
    if [ -n "$ip" ]; then
        echo "  pass: $ip"
        echo "        (from $IRIS_ENV : IRIS_ADM_PASSWORD)"
    else
        echo "  pass: NOT SET in $IRIS_ENV. DFIR-IRIS generates the administrator"
        echo "        password on first initialisation. Retrieve it on this node with:"
        echo "          sudo docker logs {{ puc2_iris_container }} 2>&1 | grep -i 'administrator'"
        echo "        (it is printed once, at first boot)."
    fi
    echo

    echo "== NG-SOAR   http://{{ docker_server_internal_ip }}:8080 =="
    echo "  No interactive login in this range; it is driven by webhook."
} > "$tmp"

install -o root -g root -m 0600 "$tmp" "$OUT"
rm -f "$tmp"
echo "wrote $OUT (0600 root)"
