# DFIR-IRIS (CICMS) environment - rendered by role docker_server.
# Secrets sourced from Ansible variables (vault), never hardcoded.
IRIS_ADM_PASSWORD={{ iris_admin_password | default('CHANGE_ME_AT_FIRST_LOGIN') }}
IRIS_ADM_API_KEY={{ iris_admin_api_key | default('') }}
POSTGRES_PASSWORD={{ iris_postgres_password | default('CHANGE_ME') }}
POSTGRES_ADMIN_PASSWORD={{ iris_postgres_admin_password | default('CHANGE_ME') }}

# MISP (CTI-SS) integration endpoint consumed by IRIS for IOC/TTP enrichment
# (UML step 8). Points at the co-located SOC services host.
IRIS_MISP_URL=https://{{ ansible_default_ipv4.address | default('10.10.10.10') }}:{{ misp_https_port }}
IRIS_MISP_KEY={{ misp_admin_api_key | default('') }}
INTERFACE_HTTPS_PORT={{ iris_https_port }}
