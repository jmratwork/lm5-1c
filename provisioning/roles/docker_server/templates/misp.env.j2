# MISP (CTI-SS) environment - rendered by role docker_server.
# All secrets come from Ansible variables (vault), never hardcoded.
BASE_URL=https://{{ ansible_default_ipv4.address | default('10.10.10.10') }}:{{ misp_https_port }}
HTTP_PORT={{ misp_http_port }}
HTTPS_PORT={{ misp_https_port }}

# Admin bootstrap credentials - supply via group_vars/vault:
#   misp_admin_email, misp_admin_password
ADMIN_EMAIL={{ misp_admin_email | default('admin@admin.test') }}
ADMIN_PASSWORD={{ misp_admin_password | default('CHANGE_ME_AT_FIRST_LOGIN') }}
ADMIN_KEY={{ misp_admin_api_key | default('') }}

MYSQL_PASSWORD={{ misp_mysql_password | default('CHANGE_ME') }}
MYSQL_ROOT_PASSWORD={{ misp_mysql_root_password | default('CHANGE_ME') }}
